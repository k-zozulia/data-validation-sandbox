# Copy to .env for running the backend outside Docker (docker-compose sets these itself).
DATABASE_URL=sqlite:///./data/dvs.db
REDIS_URL=redis://localhost:6379/0
# true = run full jobs inside the API process (no Redis/Celery needed)
INLINE_JOBS=true
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
# STORAGE_BACKEND=s3
# S3_BUCKET=dvs
# S3_ENDPOINT_URL=http://localhost:9000
MAX_FILE_SIZE_MB=100
SAMPLE_ROWS=1000
